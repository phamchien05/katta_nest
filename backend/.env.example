DATABASE_URL="mysql://root@127.0.0.1:3306/katta"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=3000

# Múi giờ dùng để tính "ngày học" (streak, biểu đồ 7 ngày, phút học hôm nay)
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Khoá mã hoá API key riêng của người dùng: chuỗi base64 của 32 byte ngẫu nhiên (cách tạo: xem README)
APP_KEY=
# Key Gemini dùng chung cho người chưa nhập key riêng
GEMINI_API_KEY=

# Thư mục lưu ảnh phản hồi (mặc định ./uploads)
# UPLOAD_DIR=./uploads
